hungerpoints.licence.legend_header=Legend
hungerpoints.licence.legend_text1=This only applies when the §6Hunger & Saturation Only§r mode is active.
hungerpoints.licence.legend_text2=§lShown on Food Items
hungerpoints.licence.legend_text3= Hunger Points replenished after consuming the item.
hungerpoints.licence.legend_text3_1= Saturation Points replenished after consuming the item.
hungerpoints.licence.legend_text4= Time needed to consume the item.
hungerpoints.licence.legend_text4_1= This icon only appears if the food is harmful to eat.
hungerpoints.licence.legend_text5=§lShown on Armor
hungerpoints.licence.legend_text6= Armor Points a piece of Armor gives after putting it on.
hungerpoints.licence.legend_text7=§lShown on Tools, Weapons and Gear
hungerpoints.licence.legend_text8= Amount of Attack Damage the tool deals when unenchanted.
hungerpoints.licence.legend_text9= Additional Attack Damage for the Sharpness Enchantment.
hungerpoints.licence.legend_text10= Maximum Durability of the item.
hungerpoints.licence.legend_text11=§lShown on Spawn Eggs
hungerpoints.licence.legend_text12= Amount of Health Points the mob has.
hungerpoints.licence.legend_text13= This means the mob is Hostile.
hungerpoints.licence.legend_text14=This means the mob is Neutral.
hungerpoints.licence.legend_text15= This means the mob is Passive.
hungerpoints.licence.legend_text16=§lShown on Banner Items
hungerpoints.licence.legend_text17= Shows icons for the respective patterns.
hungerpoints.licence.legend_text18=§lShown on Enchantments
